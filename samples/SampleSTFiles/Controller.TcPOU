<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_Controller" Id="{e5f6a7b8-c9d0-4e1f-2a3b-4c5d6e7f8091}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Controller
VAR_INPUT
setpoint:REAL;
actualValue:REAL;
kp:REAL:=1.0;
ki:REAL:=0.1;
kd:REAL:=0.01;
enable:BOOL;
END_VAR
VAR_OUTPUT
output:REAL;
error:REAL;
saturated:BOOL;
END_VAR
VAR
integral:REAL;
prevError:REAL;
dt:TIME:=T#10ms;
maxOutput:REAL:=100.0;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF enable THEN
error:=setpoint-actualValue;
integral:=integral+error*TIME_TO_REAL(dt);
output:=kp*error+ki*integral+kd*(error-prevError)/TIME_TO_REAL(dt);
prevError:=error;
IF output>maxOutput THEN
output:=maxOutput;
saturated:=TRUE;
ELSE
saturated:=FALSE;
END_IF;
ELSE
output:=0.0;
integral:=0.0;
prevError:=0.0;
error:=0.0;
saturated:=FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>